<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<title>{{ title_label }} 산불위험 브리핑</title>
<style>
  :root {
    --bg: #eef1ec;
    --surface: #ffffff;
    --surface-2: #e6e9e1;
    --ink: #1c1a16;
    --ink-soft: #4b463e;
    --muted: #7a7568;
    --line: #dcded4;
    --accent: #8a5a3b;
    --accent-strong: #6b4128;
    --accent-ink: #ffffff;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Malgun Gothic", "Apple SD Gothic Neo",
      "Noto Sans CJK KR", "Noto Sans KR", "NanumGothic", "Segoe UI", sans-serif;
    font-size: 13.5px;
    line-height: 1.6;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .doc { max-width: 100%; padding: 0 40px; }

  section.spread {
    padding: 30px 0 26px;
    break-after: page;
    page-break-after: always;
  }
  section.spread:last-of-type { break-after: auto; page-break-after: auto; }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .eyebrow::before { content: ""; width: 20px; height: 1px; background: var(--accent); }

  h1.page-title, h2.page-title {
    font-family: Batang, "바탕", "Noto Serif CJK KR", "Noto Serif KR", "NanumMyeongjo",
      "Nanum Myeongjo", Georgia, serif;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--ink);
  }
  h1.page-title { font-size: 32px; }
  h2.page-title { font-size: 24px; }

  .lede { max-width: 66ch; color: var(--ink-soft); font-size: 14px; margin: 0 0 22px; }
  .lede strong { color: var(--ink); font-weight: 700; }
  p.copy { max-width: 68ch; color: var(--ink-soft); }
  p.copy strong { color: var(--ink); }
  .footnote { font-size: 11px; color: var(--muted); margin-top: 8px; }

  /* ---------- Cover ---------- */
  .cover-date { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; margin-bottom: 16px; }
  .cover-grid { display: flex; gap: 30px; align-items: center; margin-top: 18px; }
  .cover-grid > .lede-col { flex: 1 1 auto; min-width: 0; }
  .gauge-wrap { position: relative; width: 260px; height: 260px; flex: none; }
  .gauge-center {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center; top: 14px;
  }
  .gauge-number { font-size: 40px; font-weight: 800; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; line-height: 1; }
  .gauge-scale { font-size: 11px; color: var(--muted); margin-top: 4px; }
  .gauge-band-label { margin-top: 6px; font-size: 10.5px; font-weight: 700; padding: 3px 9px; border-radius: 999px; }

  .meta-row { display: flex; flex-wrap: wrap; gap: 10px 26px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--line); }
  .meta-item { display: flex; flex-direction: column; gap: 2px; }
  .meta-item .k { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .meta-item .v { font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; }

  /* ---------- Ranking ---------- */
  .rank-list { column-count: 2; column-gap: 26px; }
  .rank-row {
    display: grid; grid-template-columns: 22px 92px minmax(0, 1fr) 36px;
    align-items: center; gap: 8px; padding: 4px 6px; break-inside: avoid;
  }
  .rank-row .r { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .rank-row .name { font-size: 12.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rank-row.top .name { color: var(--accent-strong); font-weight: 800; }
  .rank-row.highlight .name { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .rank-track { position: relative; height: 9px; background: var(--surface-2); border-radius: 999px; overflow: hidden; }
  .rank-fill { position: absolute; inset: 0 auto 0 0; border-radius: 999px; }
  .rank-row .val { font-size: 11.5px; text-align: right; font-variant-numeric: tabular-nums; color: var(--ink-soft); }

  .legend-note { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 18px; font-size: 11px; color: var(--muted); }
  .dot { width: 8px; height: 8px; border-radius: 999px; display: inline-block; }

  /* ---------- Comparison ---------- */
  .range-card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 24px 24px 16px; margin-bottom: 26px; break-inside: avoid; }
  .range-strip { position: relative; height: 12px; border-radius: 999px; overflow: hidden; display: flex; margin: 40px 4px 26px; }
  .range-strip span { flex: 1; }
  .range-marker { position: absolute; top: -32px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; font-size: 10px; white-space: nowrap; }
  .range-marker .stem { width: 1px; height: 14px; background: var(--muted); margin-top: 2px; }
  .range-marker.emph .stem { background: var(--accent-strong); width: 2px; }
  .range-marker .lbl { color: var(--muted); font-weight: 600; }
  .range-marker.emph .lbl { color: var(--accent-strong); font-weight: 800; }
  .range-marker .num { font-variant-numeric: tabular-nums; color: var(--ink); font-weight: 700; }
  .range-marker.below { top: auto; bottom: -32px; flex-direction: column-reverse; }
  .range-marker.below .stem { margin-top: 0; margin-bottom: 2px; }

  .section-label { font-size: 12px; letter-spacing: 0.04em; color: var(--muted); text-transform: uppercase; margin: 0 0 12px; }
  .prov-list { display: flex; flex-direction: column; gap: 6px; }
  .prov-row { display: grid; grid-template-columns: 84px minmax(0, 1fr) 42px; align-items: center; gap: 10px; break-inside: avoid; }
  .prov-row .name { font-size: 12.5px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
  .prov-row.target .name { font-weight: 800; color: var(--accent-strong); }
  .prov-track { position: relative; height: 14px; background: var(--surface-2); border-radius: 4px; overflow: hidden; }
  .prov-fill { position: absolute; inset: 0 auto 0 0; border-radius: 4px; }
  .prov-row.target .prov-fill { outline: 2px solid var(--accent-strong); outline-offset: -2px; }
  .prov-row .val { font-size: 11.5px; text-align: right; font-variant-numeric: tabular-nums; color: var(--ink-soft); }
  .badge { font-size: 9.5px; font-weight: 800; background: var(--accent); color: var(--accent-ink); border-radius: 999px; padding: 1px 7px; }

  /* ---------- Weather ---------- */
  .tile-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 22px; }
  .tile { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 16px 14px; break-inside: avoid; }
  .tile svg { color: var(--accent); margin-bottom: 8px; }
  .tile .k { font-size: 11px; color: var(--muted); }
  .tile .v { font-size: 21px; font-weight: 800; font-variant-numeric: tabular-nums; margin-top: 2px; }
  .tile .v small { font-size: 12px; font-weight: 600; color: var(--muted); }
  .tile .range { font-size: 10.5px; color: var(--muted); margin-top: 2px; }

  /* ---------- District cards ---------- */
  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .district-card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 18px; break-inside: avoid; }
  .district-card .chip { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; color: var(--muted); }
  .district-card .swatch { width: 9px; height: 9px; border-radius: 3px; }
  .district-card h3 { margin: 8px 0 2px; font-size: 17px; }
  .district-card .idx { font-size: 30px; font-weight: 800; font-variant-numeric: tabular-nums; color: var(--accent-strong); }
  .district-card .idx small { font-size: 13px; color: var(--muted); font-weight: 600; }
  .compare { position: relative; height: 6px; background: var(--surface-2); border-radius: 999px; margin: 18px 2px 24px; }
  .compare i { position: absolute; top: -6px; width: 2px; height: 16px; background: var(--muted); }
  .compare i.self { background: var(--accent-strong); width: 3px; }
  .compare em { position: absolute; top: -20px; transform: translateX(-50%); font-style: normal; font-size: 9.5px; color: var(--muted); white-space: nowrap; }
  .compare em.self { color: var(--accent-strong); font-weight: 800; }
  .district-card .note { font-size: 11.5px; color: var(--ink-soft); margin: 0; }

  /* ---------- Methodology ---------- */
  .method-grid { display: flex; gap: 36px; align-items: flex-start; }
  .method-grid > div { flex: 1 1 0; min-width: 0; }
  .stat-line { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed var(--line); font-size: 12.5px; }
  .stat-line span:first-child { color: var(--muted); }
  .stat-line span:last-child { font-weight: 700; font-variant-numeric: tabular-nums; }

  ul.guide { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  ul.guide li { display: flex; gap: 10px; font-size: 12.5px; color: var(--ink-soft); }
  ul.guide li::before { content: ""; flex: none; width: 6px; height: 6px; margin-top: 6px; border-radius: 999px; background: var(--accent); }

  .report-footer { padding: 22px 0 8px; color: var(--muted); font-size: 10.5px; line-height: 1.7; }
  .report-footer strong { color: var(--ink-soft); }
</style>
</head>
<body>
<div class="doc">

  <!-- 1: 표지 -->
  <section class="spread" id="p1">
    <div class="eyebrow">Wildfire Risk Bulletin</div>
    <h1 class="page-title">{{ title_label }}, 오늘의<br />산불발생위험도</h1>
    <p class="cover-date">{{ predict_date }}{% if weekday %} {{ weekday }}요일{% endif %} · 기상관측 {{ observed_at }} 기준 · ML 예측모델</p>

    <div class="cover-grid">
      <div class="lede-col">
        <p class="lede">{{ narrative.cover }}</p>
        <div class="meta-row">
          <div class="meta-item"><span class="k">대상 지역</span><span class="v">{{ n_regions }}개</span></div>
          <div class="meta-item"><span class="k">기온</span><span class="v">{{ "%.1f"|format(weather.temp_avg) }}℃</span></div>
          <div class="meta-item"><span class="k">습도</span><span class="v">{{ weather.humidity_avg|round|int }}%</span></div>
          <div class="meta-item"><span class="k">풍속</span><span class="v">{{ "%.1f"|format(weather.wind_avg) }} m/s</span></div>
          <div class="meta-item"><span class="k">강수</span><span class="v">{{ "%.1f"|format(weather.precip_avg) }} mm</span></div>
        </div>
      </div>

      <div class="gauge-wrap">
        <svg viewBox="0 0 300 300" width="260" height="260" role="img" aria-label="{{ province }} 평균 산불위험지수 {{ province_stat.avg }}, 100점 만점">
          {% for arc in gauge.arcs %}
          <path d="{{ arc.path }}" stroke="{{ arc.color }}" stroke-width="22" fill="none" stroke-linecap="round"/>
          {% endfor %}

          <circle cx="{{ gauge.dots.national_avg.x }}" cy="{{ gauge.dots.national_avg.y }}" r="4" fill="var(--surface)" stroke="var(--muted)" stroke-width="2"/>
          <circle cx="{{ gauge.dots.province_min.x }}" cy="{{ gauge.dots.province_min.y }}" r="4" fill="var(--surface)" stroke="var(--muted)" stroke-width="2"/>
          <circle cx="{{ gauge.dots.province_max.x }}" cy="{{ gauge.dots.province_max.y }}" r="4" fill="var(--surface)" stroke="var(--muted)" stroke-width="2"/>

          <line x1="150" y1="150" x2="{{ gauge.needle.x }}" y2="{{ gauge.needle.y }}" stroke="var(--accent-strong)" stroke-width="4" stroke-linecap="round"/>
          <circle cx="150" cy="150" r="8" fill="var(--accent-strong)"/>

          {% for t in gauge.ticks %}
          <text x="{{ t.x }}" y="{{ t.y + 4 }}" text-anchor="middle" font-size="10" fill="var(--muted)">{{ t.v }}</text>
          {% endfor %}
        </svg>
        <div class="gauge-center">
          <div class="gauge-number">{{ "%.1f"|format(province_stat.avg) }}</div>
          <div class="gauge-scale">{{ province }} 평균 · 100점 만점</div>
          <div class="gauge-band-label" style="background:{{ province_stat.band_color }}; color:{{ province_stat.band_text }};">{{ province_stat.band_lo }}–{{ province_stat.band_hi }} 구간</div>
        </div>
      </div>
    </div>
    <p class="footnote">회색 점 = 전국 평균({{ national.avg }}) · {{ province }} 최저({{ province_stat.min }}) · {{ province }} 최고({{ province_stat.max }}) — 왼쪽부터 순서대로</p>
  </section>

  <!-- 2: 지역별 순위 -->
  <section class="spread" id="p2">
    <div class="eyebrow">District Ranking</div>
    <h2 class="page-title">지역별 산불위험지수 순위</h2>
    <p class="lede">{{ narrative.rank_summary }}</p>

    <div class="rank-list">
      {% for row in ranking %}
      <div class="rank-row{% if row.is_top %} top{% endif %}{% if row.is_highlight %} highlight{% endif %}">
        <span class="r">{{ row.rank }}</span>
        <span class="name">{{ row.name }}</span>
        <div class="rank-track"><div class="rank-fill" style="width:{{ row.width_pct }}%; background:{{ row.color }}"></div></div>
        <span class="val">{{ "%.1f"|format(row.idx) }}</span>
      </div>
      {% endfor %}
    </div>

    <div class="legend-note">
      {% for b in band_legend %}
      <span class="dot" style="background:{{ b.color }}"></span> {{ b.lo }}–{{ b.hi }} 구간{% if not loop.last %}&nbsp;&nbsp;{% endif %}
      {% endfor %}
      <span style="margin-left:auto">막대 길이 = 위험지수(0–100 기준) · 동일 지수는 공동 순위</span>
    </div>
  </section>

  <!-- 3: 전국 비교 -->
  <section class="spread" id="p3">
    <div class="eyebrow">vs. National</div>
    {% if is_national %}
    <h2 class="page-title">전국 17개 시·도별 산불위험지수 비교</h2>
    <p class="lede">전국 {{ national.count }}개 시·군·구를 시·도 단위로 묶어 평균을 비교했습니다.</p>
    {% else %}
    <h2 class="page-title">{{ province }}{{ province_eun_neun }} 전국 {{ province_stat.count }}개 시·도 중 {{ province_stat.rank }}위</h2>
    <p class="lede">전국 {{ national.count }}개 시·군·구 분포 대비 {{ province }}의 위치를 표시했습니다.</p>

    <div class="range-card">
      <div class="range-strip">
        <span style="background:#0D2F6B"></span><span style="background:#1E5AA8"></span>
        <span style="background:#0E7C8A"></span><span style="background:#3DB8E8"></span>
        <span style="background:#7BCB2E"></span><span style="background:#C5D94A"></span>
        <span style="background:#F2E14A"></span><span style="background:#F5B84A"></span>
        <span style="background:#F07A1A"></span><span style="background:#E53935"></span>

        <div class="range-marker below" style="left:{{ national.min }}%"><span class="num">{{ "%.1f"|format(national.min) }}</span><span class="lbl">전국 최저</span><span class="stem"></span></div>
        <div class="range-marker" style="left:{{ national.avg }}%"><span class="lbl">전국 평균</span><span class="num">{{ national.avg }}</span><span class="stem"></span></div>
        <div class="range-marker emph below" style="left:{{ province_stat.avg }}%"><span class="num">{{ province_stat.avg }}</span><span class="lbl">{{ province }} 평균</span><span class="stem"></span></div>
        <div class="range-marker" style="left:{{ national.max }}%"><span class="lbl">전국 최고 · {{ national.max_name }}</span><span class="num">{{ "%.1f"|format(national.max) }}</span><span class="stem"></span></div>
      </div>
      <p class="footnote" style="margin-top:0">위험지수 0–100 전 구간 대비 위치 · 색상은 국가산불위험예보 10단계 배색과 동일</p>
    </div>
    {% endif %}

    <h3 class="section-label">시·도별 평균 위험지수</h3>
    <div class="prov-list">
      {% for row in province_table %}
      <div class="prov-row{% if row.is_target %} target{% endif %}">
        <span class="name">{{ row.name }}{% if row.is_target %} <span class="badge">{{ row.rank }}위</span>{% endif %}</span>
        <div class="prov-track"><div class="prov-fill" style="width:{{ row.width_pct }}%; background:{{ row.color }}"></div></div>
        <span class="val">{{ "%.1f"|format(row.avg) }}</span>
      </div>
      {% endfor %}
    </div>
    <p class="footnote">지수는 기상 4개 + 시군구 이력 2개 + 건조지수 + 강수파생 3개 변수를 결합한 상대값입니다. 자세한 해석은 06 방법론을 참고하세요.</p>
  </section>

  <!-- 4: 기상 조건 -->
  <section class="spread" id="p4">
    <div class="eyebrow">Weather Conditions</div>
    <h2 class="page-title">오늘의 기상 조건</h2>
    <p class="lede">{{ narrative.weather_note }}</p>

    <div class="tile-grid">
      <div class="tile">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 15.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/><path d="M12 15V5.5a2 2 0 1 0-4 0"/><path d="M8 5.5v9.9"/></svg>
        <div class="k">기온</div>
        <div class="v">{{ "%.1f"|format(weather.temp_avg) }}<small> ℃</small></div>
        {% if not weather.uniform %}<div class="range">{{ "%.1f"|format(weather.temp_min) }} ~ {{ "%.1f"|format(weather.temp_max) }}</div>{% endif %}
      </div>
      <div class="tile">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg>
        <div class="k">습도</div>
        <div class="v">{{ weather.humidity_avg|round|int }}<small> %</small></div>
        {% if not weather.uniform %}<div class="range">{{ weather.humidity_min|round|int }} ~ {{ weather.humidity_max|round|int }}</div>{% endif %}
      </div>
      <div class="tile">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 8h11a2.5 2.5 0 1 0-2.2-3.6"/><path d="M3 12h14a2.5 2.5 0 1 1-2.2 3.6"/><path d="M3 16h8"/></svg>
        <div class="k">풍속</div>
        <div class="v">{{ "%.1f"|format(weather.wind_avg) }}<small> m/s</small></div>
        {% if not weather.uniform %}<div class="range">{{ "%.1f"|format(weather.wind_min) }} ~ {{ "%.1f"|format(weather.wind_max) }}</div>{% endif %}
      </div>
      <div class="tile">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14.5a4 4 0 0 1 .7-7.9 5 5 0 0 1 9.6 1.4A3.5 3.5 0 0 1 17 14.5H7Z"/><path d="M9 18v1.2M12.5 18v1.2M16 18v1.2"/></svg>
        <div class="k">강수</div>
        <div class="v">{{ "%.1f"|format(weather.precip_avg) }}<small> mm</small></div>
        {% if not weather.uniform %}<div class="range">최대 {{ "%.1f"|format(weather.precip_max) }}</div>{% endif %}
      </div>
    </div>
    <p class="copy">{{ narrative.weather_desc }}</p>
  </section>

  <!-- 5: 상위 지역 상세 -->
  <section class="spread" id="p5">
    <div class="eyebrow">Top Districts</div>
    <h2 class="page-title">{% if province_stat.top_group_size > 1 %}공동 1위 지역 상세{% else %}주요 지역 상세{% endif %}</h2>
    <p class="lede">{{ province }} 평균({{ province_stat.avg }})·전국 평균({{ national.avg }}) 대비 위치를 함께 표시했습니다.</p>

    <div class="card-grid">
      {% for row in spotlight %}
      <div class="district-card">
        <div class="chip"><span class="swatch" style="background:{{ row.color }}"></span>{{ row.band_lo }}–{{ row.band_hi }} 구간{% if row.is_highlight and not row.is_top %} · 조회 지역{% endif %}</div>
        <h3>{{ row.name }}</h3>
        <div class="idx">{{ "%.1f"|format(row.idx) }}<small> / 100</small></div>
        <div class="compare">
          {% for m in row.marks %}
          <i class="{{ 'self' if m.is_self else '' }}" style="left:{{ m.value }}%"></i>
          <em class="{{ 'self' if m.is_self else '' }}" style="left:{{ m.value }}%">{{ m.label }}</em>
          {% endfor %}
        </div>
        <p class="note">{{ province }}에서 {{ row.rank }}위{% if row.rank == 1 and province_stat.top_group_size > 1 %} (공동 1위 {{ province_stat.top_group_size }}개 지역 중){% endif %}.</p>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- 6: 해석 및 안내 -->
  <section class="spread" id="p6">
