# Express backend — copy to .env and fill in
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
ML_SERVICE_URL=http://127.0.0.1:5000

# 안내 챗봇 (필수 — 없으면 /api/chat 503)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 회원·챗봇 영속화 (ml-service 와 동일 MariaDB)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=forest_fire_DB

# 로그인 세션 쿠키 서명 (배포 시 반드시 랜덤 긴 문자열로)
SESSION_SECRET=
# SESSION_DAYS=14

# 구글/카카오 로그인 (미설정이면 버튼은 보이지만 설정 안내)
# Redirect URI 를 콘솔에 등록:
#   {FRONTEND_ORIGIN}/api/auth/google/callback
#   {FRONTEND_ORIGIN}/api/auth/kakao/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=http://localhost:3000
